# Roboflow Computer Vision Configuration
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL=yolov8n-640
ROBOFLOW_INFERENCE_URL=https://detect.roboflow.com

# Database Connection (SQLite default for instant local dev, or PostgreSQL+PostGIS)
DATABASE_URL=sqlite+aiosqlite:///./geocv.db
# DATABASE_URL=postgresql+asyncpg://geocv:geocv_password@localhost:5432/geocv_db

# Routing Engine
ROUTING_PROVIDER=osrm
OSRM_BASE_URL=https://router.project-osrm.org
ROUTING_API_KEY=

# Default Camera Location (Bangalore Plaza Coordinates)
DEFAULT_CAMERA_ID=CAM-001
DEFAULT_CAMERA_NAME=Sector-Alpha High Gate
DEFAULT_CAMERA_LAT=12.971598
DEFAULT_CAMERA_LON=77.594566
DEFAULT_CAMERA_HEADING=45.0
DEFAULT_CAMERA_FOV=72.0
DEFAULT_CAMERA_RANGE=120.0
DEFAULT_MOUNTING_HEIGHT=3.5
DEFAULT_CONFIDENCE_THRESHOLD=0.50
DEFAULT_CROWD_THRESHOLD=8
